{
  "name": "skill-loom",
  "version": "0.5.0",
  "description": "One canonical, git-versioned vault of agent skills, symlinked into every runtime (Claude Code, Codex, custom).",
  "type": "module",
  "bin": {
    "skill-loom": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc && node scripts/gen-icons.mjs && cp src/ui.html src/ui.css src/ui.js src/favicon.ico src/favicon-32.png src/favicon-16.png src/apple-touch-icon.png node_modules/mermaid/dist/mermaid.min.js dist/src/",
    "test": "npm run build && node --test 'dist/test/**/*.test.js'",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "agent-skills",
    "claude-code",
    "codex",
    "claude",
    "ai-agents",
    "agent-tooling",
    "skills",
    "prompt-management",
    "vault",
    "symlink",
    "single-source-of-truth",
    "cli"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/michelepastorello/skill-loom.git"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "lucide-static": "1.24.0",
    "mermaid": "^11.16.0",
    "typescript": "^6.0.3"
  }
}
